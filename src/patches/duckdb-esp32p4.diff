--- a/src/common/allocator/allocator_standard.cpp
+++ b/src/common/allocator/allocator_standard.cpp
@@ -5,6 +5,11 @@
 #include "duckdb/common/assert.hpp"
 #include "duckdb/common/exception.hpp"
 #include "duckdb/common/helper.hpp"
+#ifdef ESP_PLATFORM
+#include <cstddef>
+#include <cstdlib>
+#include "esp_heap_caps.h"
+#endif

 #ifdef DUCKDB_DEBUG_ALLOCATION
 #include "duckdb/common/mutex.hpp"
@@ -17,7 +22,13 @@
 namespace duckdb {

 data_ptr_t Allocator::DefaultAllocate(PrivateAllocatorData *private_data, idx_t size) {
+#ifdef ESP_PLATFORM
+	// Do not fall back to scarce internal SRAM when PSRAM is exhausted.
+	auto default_allocate_result = heap_caps_aligned_alloc(alignof(std::max_align_t), size,
+	                                                       MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+#else
 	auto default_allocate_result = malloc(size);
+#endif
 	if (!default_allocate_result) {
 		throw std::bad_alloc();
 	}
@@ -30,7 +41,20 @@ void Allocator::DefaultFree(PrivateAllocatorData *private_data, data_ptr_t point

 data_ptr_t Allocator::DefaultReallocate(PrivateAllocatorData *private_data, data_ptr_t pointer, idx_t old_size,
                                         idx_t size) {
+#ifdef ESP_PLATFORM
+	if (size == 0) {
+		free(pointer);
+		return nullptr;
+	}
+	auto result = DefaultAllocate(private_data, size);
+	if (pointer) {
+		memcpy(result, pointer, MinValue(old_size, size));
+		free(pointer);
+	}
+	return result;
+#else
 	return data_ptr_cast(realloc(pointer, size));
+#endif
 }

 optional_idx Allocator::DecayDelay() {
